# Supported providers: codex, anthropic, antigravity, warp
# Defaults to codex,anthropic when unset.
QUOTA_PROVIDERS=codex,anthropic
QUOTA_PORT=8787
# Keep quota snapshots, reset credits, and optional lifecycle markers.
QUOTA_RETENTION_DAYS=forever
# Optional read-only overrides for Antigravity Cloud Code OAuth credentials:
# QUOTA_ANTIGRAVITY_AUTH_PATH=/path/to/oauth_creds.json
# ANTIGRAVITY_OAUTH_CREDENTIALS_JSON={"access_token":"..."}
